# --- Application ---
# URL publique de l'application (sans slash final). Utilisée dans les emails et redirections.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clé publique (anon / publishable). Peut être exposée au navigateur : la sécurité repose sur RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SERVEUR UNIQUEMENT. Contourne RLS. Utilisée par le cron, les webhooks,
# la démo, la suppression de compte et le rate limiting. Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Tâches planifiées ---
# Secret partagé avec Vercel Cron (en-tête Authorization: Bearer <CRON_SECRET>). 32+ caractères aléatoires.
CRON_SECRET=

# --- Emails transactionnels (Resend) — optionnel ---
# Sans ces variables, l'application fonctionne en mode manuel (copier le message, marquer comme envoyé).
RESEND_API_KEY=
# Adresse d'expédition sur un domaine vérifié dans Resend, ex. relances@mail.votredomaine.fr
RESEND_FROM_EMAIL=
# Secret de signature des webhooks Resend (whsec_...), pour le suivi des statuts de délivrance.
RESEND_WEBHOOK_SECRET=

# --- Démonstration ---
# Nombre maximal d'espaces de démo créés par heure et par adresse IP (défaut : 8)
DEMO_RATE_LIMIT_PER_HOUR=8
